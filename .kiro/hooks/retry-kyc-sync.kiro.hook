{
  "enabled": true,
  "name": "Retry KYC Sync",
  "description": "Starts the KYC correction retry once data is confirmed uploaded.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Continue the paused KYC 0812-0818 sync: check DataWind through FortiVPN, re-fetch, validate increments, then dry-run and overwrite only after checks pass."
  }
}